import numpy as np
import pandas as pd
import pickle
import json
import librosa
from pathlib import Path
from sklearn.model_selection import train_test_split
from tqdm import tqdm
import warnings
import os
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'  # Normalizes info/warning logs
os.environ['TF_ENABLE_ONEDNN_OPTS'] = '0' # disables oneDNN warning
import tensorflow as tf

warnings.filterwarnings('ignore')



class DataConfig:
    DATA_TYPE = 'audio' 
    AUDIO_DATASET_PATH = r'C:\Users\hrshe\OneDrive\Documents\Codes\NN\Data\genres_original'
    SAMPLE_RATE = 22050
    AUDIO_PARAMS = {
        'num_mfcc': 40,
        'n_fft': 2048,
        'hop_length': 512,
        'num_segment': 10,
        'target_time_steps': 130
    }
    
    SAVE_DIR = r'C:\Users\hrshe\OneDrive\Documents\Codes\NN\Data\processed_data'
    TEST_SIZE = 0.2
    VAL_SIZE = 0.1
    RANDOM_STATE = 42
    SHUFFLE = True

class AudioProcessor:
    
    def __init__(self, dataset_path, sample_rate=22050):
        self.dataset_path = dataset_path
        self.sample_rate = sample_rate
        self.class_names = None
        
    def get_class_names(self):
        if not os.path.exists(self.dataset_path):
            raise FileNotFoundError(f"Audio dataset path not found: {self.dataset_path}")
        self.class_names = sorted([d for d in os.listdir(self.dataset_path) 
                                  if os.path.isdir(os.path.join(self.dataset_path, d))])
        return self.class_names
    
    def extract_features(self, num_mfcc=40, n_fft=2048, hop_length=512, 
                         num_segment=10, target_time_steps=130):
        self.class_names = self.get_class_names()
        data = {"features": [], "labels": []}
        samples_per_segment = int(self.sample_rate * 30 / num_segment)
        
        for label_idx, genre in enumerate(self.class_names):
            genre_path = os.path.join(self.dataset_path, genre)
            audio_files = sorted([f for f in os.listdir(genre_path) if f.endswith('.wav')])
            
            print(f"\nProcessing '{genre}':")
            for filename in tqdm(audio_files, desc=f"  {genre}"):
                file_path = os.path.join(genre_path, filename)
                try:
                    y, sr = librosa.load(file_path, sr=self.sample_rate)
                    target_length = self.sample_rate * 30
                    y = librosa.util.fix_length(y, size=target_length)
                    
                    for n in range(num_segment):
                        start = samples_per_segment * n
                        end = samples_per_segment * (n + 1)
                        segment = y[start:end]
                        
                        mfcc = librosa.feature.mfcc(y=segment, sr=sr, n_mfcc=num_mfcc, n_fft=n_fft, hop_length=hop_length)
                        mfcc_delta = librosa.feature.delta(mfcc)
                        mfcc_delta2 = librosa.feature.delta(mfcc, order=2)
                        
                        features = np.stack([mfcc, mfcc_delta, mfcc_delta2], axis=-1)
                        
                        if features.shape[1] < target_time_steps:
                            features = np.pad(features, ((0,0), (0, target_time_steps - features.shape[1]), (0,0)))
                        else:
                            features = features[:, :target_time_steps, :]
                        
                        data["features"].append(features)
                        data["labels"].append(label_idx)
                except Exception as e:
                    continue
        
        return np.array(data["features"], dtype=np.float32), np.array(data["labels"], dtype=np.int64), self.class_names

def load_and_preprocess_data(config):
    audio_processor = AudioProcessor(config.AUDIO_DATASET_PATH, config.SAMPLE_RATE)
    X, y, class_names = audio_processor.extract_features(**config.AUDIO_PARAMS)
    
    # Split data
    X_temp, X_test, y_temp, y_test = train_test_split(
        X, y, test_size=config.TEST_SIZE, random_state=config.RANDOM_STATE, 
        shuffle=config.SHUFFLE, stratify=y
    )
    
    val_ratio = config.VAL_SIZE / (1 - config.TEST_SIZE)
    X_train, X_val, y_train, y_val = train_test_split(
        X_temp, y_temp, test_size=val_ratio, random_state=config.RANDOM_STATE, 
        shuffle=config.SHUFFLE, stratify=y_temp
    )

    
    return {
        'X_train': tf.convert_to_tensor(X_train),
        'y_train': tf.convert_to_tensor(y_train),
        'X_val': tf.convert_to_tensor(X_val),
        'y_val': tf.convert_to_tensor(y_val),
        'X_test': tf.convert_to_tensor(X_test),
        'y_test': tf.convert_to_tensor(y_test),
        'class_names': class_names,
        'audio_params': config.AUDIO_PARAMS,
        'data_type': config.DATA_TYPE
    }

def save_data_tf(data, save_dir):
    save_path = Path(save_dir)
    save_path.mkdir(parents=True, exist_ok=True)
    
    # Save as .npz for easy loading in TensorFlow environments
    np.savez_compressed(
        save_path / 'data_arrays.npz',
        X_train=data['X_train'].numpy(), y_train=data['y_train'].numpy(),
        X_val=data['X_val'].numpy(), y_val=data['y_val'].numpy(),
        X_test=data['X_test'].numpy(), y_test=data['y_test'].numpy()
    )
    
    
    metadata = {
        'class_names': data['class_names'],
        'audio_params': data['audio_params'],
        'data_type': data['data_type']
    }
    with open(save_path / 'metadata.json', 'w') as f:
        json.dump(metadata, f)
    print(f" Data saved to {save_path}")

def create_tf_datasets(data_path, batch_size=32):
    """Replacement for PyTorch DataLoaders"""
    archive = np.load(Path(data_path) / 'data_arrays.npz')
    
    def make_ds(x, y, shuffle=False):
        ds = tf.data.Dataset.from_tensor_slices((x, y))
        if shuffle:
            ds = ds.shuffle(1000)
        return ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)

    train_ds = make_ds(archive['X_train'], archive['y_train'], shuffle=True)
    val_ds = make_ds(archive['X_val'], archive['y_val'])
    test_ds = make_ds(archive['X_test'], archive['y_test'])
    
    return train_ds, val_ds, test_ds

def main():
    config = DataConfig()
    data = load_and_preprocess_data(config)
    save_data_tf(data, config.SAVE_DIR)
    
    # Load and test
    train_ds, _, _ = create_tf_datasets(config.SAVE_DIR)
    for x, y in train_ds.take(1):
        print(f"TF Batch X Shape: {x.shape}") 
        print(f"TF Batch y Shape: {y.shape}")

if __name__ == "__main__":
    main()